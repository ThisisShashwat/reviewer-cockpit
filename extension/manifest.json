{
  "manifest_version": 3,
  "name": "Cockpit Quick Ingest Helper",
  "version": "1.1.0",
  "description": "One-click copy and bulk sync of submission JSON from live.hackclub.com/review to Reviewer Cockpit.",
  "permissions": [
    "clipboardWrite",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://live.hackclub.com/*",
    "*://*.hackclub.com/*",
    "*://*.airtable.com/*",
    "file://*/*",
    "*://localhost/*",
    "*://localhost:*/*",
    "*://127.0.0.1/*",
    "*://127.0.0.1:*/*",
    "*://192.168.*.*/*",
    "*://192.168.*.*:*/*",
    "*://100.*.*.*/*",
    "*://100.*.*.*:*/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://live.hackclub.com/*",
        "*://*.hackclub.com/*",
        "*://*.airtable.com/*",
        "file://*/*",
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}